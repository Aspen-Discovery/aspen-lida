{
  "cli": {
	"version": "20.1.0",
  "appVersionSource": "local"
  },
  "build": {
	"production": {
	  "yarn": "1.22.22",
	  "distribution": "store",
	  "channel": "production",
	  "env": {
		"APP_ENV": "{{APP_ENV}}",
		"GOOGLE_SERVICES_JSON": "/"
	  },
	  "android": {
		"resourceClass": "large"
	  },
	  "ios": {
		"image": "macos-sequoia-15.6-xcode-26.0",
		"resourceClass": "medium"
	  }
	},
	"beta": {
	  "extends": "production",
	  "channel": "beta",
	  "android": {
		"resourceClass": "large"
	  },
	  "ios": {
		"resourceClass": "medium"
	  }
	},
	"alpha": {
	  "extends": "production",
	  "distribution": "internal",
	  "channel": "alpha",
	  "ios": {
		"simulator": true,
		"resourceClass": "medium"
	  },
	  "android": {
		"buildType": "apk",
		"resourceClass": "large"
	  }
	},
	"development": {
	  "extends": "production",
	  "channel": "development",
	  "developmentClient": true,
	  "distribution": "internal",
	  "ios": {
		"simulator": true,
		"resourceClass": "medium"
	  }
	},
	"internal": {
	  "extends": "production",
	  "channel": "internal"
	},
	"development-local": {
		"extends": "development",
		"ios": {
			"simulator": true
		},
		"android": {
			"buildType": "apk"
		}
	}
  },
  "submit": {
	"production": {
	  "android": {
		"track": "production",
		"releaseStatus": "draft",
		"serviceAccountKeyPath": "{{DEV_GOOGLE_SERVICE_KEY_PATH}}"
	  },
	  "ios": {
		"ascApiKeyPath": "{{DEV_APPLE_API_KEY_PATH}}",
		"ascApiKeyIssuerId": "{{DEV_APPLE_API_KEY_ISSUER_ID}}",
		"ascApiKeyId": "{{DEV_APPLE_API_KEY_ID}}",
		"appleId": "{{DEV_APPLE_ID}}",
		"ascAppId": "{{DEV_APP_ID}}",
		"appleTeamId": "{{DEV_TEAM_ID}}"
	  }
	},
	"beta": {
	  "extends": "production",
	  "android": {
		"track": "beta"
	  }
	},
	"internal": {
	  "extends": "production",
	  "android": {
		"track": "internal",
		"releaseStatus": "draft"
	  }
	}
  }
}
